{
    "version": 2,
    "functions": {
        "api/*.js": {
            "runtime": "nodejs18.x"
        }
    },
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.js"
        },
        {
            "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico|json|html))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/$1.html"
        }
    ]
}